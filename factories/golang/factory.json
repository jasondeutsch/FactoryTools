{
  "name": "golang",
  "owner": "coordinator",
  "defaults": {
    "runner": "pi",
    "provider": "team-gateway",
    "model": "your-model-id",
    "thinking": "medium",
    "tools": [
      "read",
      "bash",
      "edit",
      "write",
      "grep",
      "find",
      "ls"
    ],
    "mcps": [
      "comms"
    ],
    "check_timeout_seconds": 30
  },
  "providers": {
    "team-gateway": {
      "baseUrl": "https://gateway.example.com/v1",
      "api": "openai-completions",
      "apiKey": "${TEAM_MODEL_API_KEY}",
      "models": [
        {
          "id": "your-model-id"
        }
      ]
    }
  },
  "mcps": {
    "comms": {
      "url": "http://127.0.0.1:8090/mcp",
      "description": "Factory task status, inbox messages, decisions, evidence, usage, and reports.",
      "exposure": "codemode"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      },
      "description": "Read requested Linear issues, comments, projects, and related planning context.",
      "exposure": "codemode"
    },
    "gopls": {
      "command": "gopls",
      "args": [
        "mcp"
      ],
      "description": "Explore and diagnose the Go project using gopls.",
      "exposure": "codemode"
    }
  },
  "extensions": {
    "ralph": {
      "source": "git:github.com/edxeth/pi-ralph-loop@108823f8d1e2089fec1f7202ca3a8905d12df574",
      "skills": [],
      "prompts": [],
      "themes": []
    }
  },
  "agents": [
    {
      "name": "coordinator",
      "path": "@factory/orchestrator",
      "skills": [
        "@factory/orchestrator/comms/skills/task-comms"
      ]
    },
    {
      "name": "architect",
      "path": "../../agents/architect",
      "skills": [
        "@factory/orchestrator/comms/skills/task-comms",
        "../../agents/architect/skills/spec-and-plan",
        "../../agents/architect/skills/software-architecture",
        "../../agents/architect/skills/domain-modeling",
        "../../skills/conventional-commits",
        "../../skills/evidence-based-debugging",
        "../../skills/linear-context"
      ],
      "config": {
        "thinking": "high"
      },
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true
      }
    },
    {
      "name": "architecture_reviewer",
      "path": "../../agents/architecture_reviewer",
      "skills": [
        "@factory/orchestrator/comms/skills/task-comms",
        "../../agents/architecture_reviewer/skills/architecture-challenge",
        "../../skills/conventional-commits",
        "../../skills/evidence-based-debugging",
        "../../skills/linear-context"
      ],
      "config": {
        "thinking": "high"
      },
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true
      }
    },
    {
      "name": "coder_golang",
      "path": "../../agents/coder_golang",
      "skills": [
        "@factory/orchestrator/comms/skills/task-comms",
        "../../agents/coder_golang/skills/go-implementation",
        "skills/go-code-quality",
        "skills/go-testing",
        "skills/go-concurrency",
        "../../skills/conventional-commits",
        "../../skills/evidence-based-debugging",
        "../../skills/bounded-iteration"
      ],
      "mcps": [
        "gopls",
        "comms"
      ],
      "extensions": [
        "ralph"
      ],
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true,
        "require_checks": true
      },
      "config": {
        "loop": {
          "prompt": "/ralph-loop --max-iterations={iterations} Follow the loaded bounded-iteration skill. Read task {task_dir}, canonical assignment, approvals, spec.html, plan.html and progress.md every iteration. Work on one ready item. Publish progress/results through comms. Stop for missing assignment, changed approval or blockers with <promise>STOP</promise>; use <promise>NEXT</promise> or <promise>COMPLETE</promise> only as defined by the skill. Do not commit without authorization.",
          "approval_artifacts": [
            "spec.html",
            "plan.html"
          ],
          "commands": [
            "ralph-loop",
            "ralph-status",
            "ralph-stop",
            "ralph-resume"
          ]
        }
      }
    },
    {
      "name": "code_reviewer_golang",
      "path": "../../agents/code_reviewer_golang",
      "skills": [
        "@factory/orchestrator/comms/skills/task-comms",
        "../../agents/code_reviewer_golang/skills/go-review",
        "../../agents/code_reviewer_golang/skills/critical-code-review",
        "skills/go-code-quality",
        "skills/go-testing",
        "skills/go-concurrency",
        "../../skills/conventional-commits",
        "../../skills/evidence-based-debugging",
        "../../skills/linear-context"
      ],
      "mcps": [
        "gopls",
        "comms"
      ],
      "config": {
        "thinking": "high"
      },
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true,
        "require_checks": true
      }
    }
  ],
  "artifacts": {
    "spec.html": "templates/spec.html",
    "plan.html": "templates/plan.html"
  },
  "recipe": "README.md"
}
