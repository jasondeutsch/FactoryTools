{
  "name": "golang",
  "owner": "coordinator",
  "agents": [
    {
      "name": "architect",
      "path": "../../agents/architect",
      "entrypoint": "start.sh"
    },
    {
      "name": "architecture_reviewer",
      "path": "../../agents/architecture_reviewer",
      "entrypoint": "start.sh"
    },
    {
      "name": "coder_golang",
      "path": "../../agents/coder_golang",
      "entrypoint": "start.sh"
    },
    {
      "name": "code_reviewer_golang",
      "path": "../../agents/code_reviewer_golang",
      "entrypoint": "start.sh"
    }
  ],
  "artifacts": {
    "spec.html": "../../skills/spec-and-plan/templates/spec.html",
    "plan.html": "../../skills/spec-and-plan/templates/plan.html"
  },
  "recipe": "README.md",
  "workflow": {
    "start": "specification",
    "steps": [
      {
        "id": "specification",
        "type": "agent",
        "agent": "architect",
        "title": "Draft specification and plan",
        "instructions": "Inspect the project and task brief. Develop spec.html and plan.html using your linked skills; report material questions and limitations.",
        "inputs": [
          "task brief",
          "project source"
        ],
        "outputs": [
          "spec.html",
          "plan.html"
        ],
        "on": {
          "completed": "architecture_review",
          "ready_for_review": "architecture_review",
          "failed": "$blocked"
        },
        "handoff": {
          "require_artifacts": true,
          "require_limitations": true
        }
      },
      {
        "id": "architecture_review",
        "type": "agent",
        "agent": "architecture_reviewer",
        "title": "Review specification and plan",
        "instructions": "Critically review the current spec.html and plan.html against the task brief and project. Return completed only when no material changes are needed; return changes_requested with actionable findings otherwise.",
        "inputs": [
          "task brief",
          "spec.html",
          "plan.html",
          "project source"
        ],
        "outputs": [
          "architecture review findings"
        ],
        "on": {
          "completed": "design_approval",
          "changes_requested": "specification",
          "failed": "$blocked"
        },
        "handoff": {
          "require_artifacts": true,
          "require_limitations": true
        }
      },
      {
        "id": "design_approval",
        "type": "decision",
        "actor": "human",
        "artifacts": [
          "spec.html",
          "plan.html"
        ],
        "on": {
          "approve": "build",
          "request_changes": "specification",
          "reject": "$blocked"
        }
      },
      {
        "id": "build",
        "type": "agent",
        "agent": "coder_golang",
        "title": "Implement approved plan",
        "instructions": "Implement the approved spec and plan in the project root. Run relevant checks, record progress and evidence, and hand off the changes for independent review.",
        "inputs": [
          "approved spec.html",
          "approved plan.html",
          "project source"
        ],
        "outputs": [
          "implementation changes",
          "progress and check evidence"
        ],
        "on": {
          "ready_for_review": "code_review",
          "completed": "code_review",
          "failed": "$blocked"
        },
        "loop": {
          "prompt": "/ralph-loop --max-iterations={iterations} Follow the loaded bounded-iteration skill. Read task {task_dir}, canonical assignment, approvals, spec.html, plan.html and progress.md every iteration. Work on one ready item. Publish progress/results through comms. Stop for missing assignment, changed approval or blockers with <promise>STOP</promise>; use <promise>NEXT</promise> or <promise>COMPLETE</promise> only as defined by the skill. Do not commit without authorization.",
          "approval_artifacts": [
            "spec.html",
            "plan.html"
          ],
          "commands": [
            "ralph-loop",
            "ralph-status",
            "ralph-stop",
            "ralph-resume"
          ]
        },
        "handoff": {
          "require_artifacts": true,
          "require_limitations": true,
          "require_checks": true
        }
      },
      {
        "id": "code_review",
        "type": "agent",
        "agent": "code_reviewer_golang",
        "title": "Review implementation",
        "instructions": "Independently review the implementation against the approved spec and plan. Return completed when the work meets them; return changes_requested with concrete findings otherwise.",
        "inputs": [
          "approved spec.html",
          "approved plan.html",
          "implementation changes"
        ],
        "outputs": [
          "code review findings and verification evidence"
        ],
        "on": {
          "completed": "acceptance",
          "changes_requested": "build",
          "failed": "$blocked"
        },
        "handoff": {
          "require_artifacts": true,
          "require_limitations": true,
          "require_checks": true
        }
      },
      {
        "id": "acceptance",
        "type": "decision",
        "actor": "human",
        "artifacts": [],
        "on": {
          "approve": "$done",
          "request_changes": "build",
          "reject": "$blocked"
        }
      }
    ]
  }
}
