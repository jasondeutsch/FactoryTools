{
  "name": "writing",
  "owner": "coordinator",
  "agents": [
    {
      "name": "pair_writer",
      "path": "../../agents/pair_writer",
      "entrypoint": "start.sh"
    },
    {
      "name": "architecture_reviewer",
      "path": "../../agents/architecture_reviewer",
      "entrypoint": "start.sh"
    }
  ],
  "recipe": "README.md",
  "workflow": {
    "start": "draft",
    "steps": [
      {
        "id": "draft",
        "type": "agent",
        "agent": "pair_writer",
        "title": "Develop working draft",
        "instructions": "Work interactively with the user on the requested document. Preserve decisions and source evidence; submit the draft for feedback.",
        "inputs": [
          "task brief",
          "source material"
        ],
        "outputs": [
          "working draft and decision notes"
        ],
        "on": {
          "completed": "feedback",
          "ready_for_review": "feedback",
          "failed": "$blocked"
        }
      },
      {
        "id": "feedback",
        "type": "decision",
        "actor": "human",
        "artifacts": [],
        "on": {
          "approve": "$done",
          "request_changes": "draft",
          "reject": "$blocked"
        }
      }
    ]
  }
}
